# Dependencies and generated frontend assets.
node_modules/
/public/assets/

# Local service state, caches, and logs.
/.run/
/.cache/
/.npm/
*.log
*.log.*
*.pid
*.pid.lock

# Test reports and coverage.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/.playwright-mcp/
/coverage/
/.nyc_output/

# Local environment values; keep shareable templates trackable.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Session archive data stays local; version only its directory helper.
/sessions/*
!/sessions/today.sh

# Private exports, including copies organized into subdirectories.
codex-session-*.md
codex-session-*.markdown
codex-session-*.txt
codex-session-*.jsonl
rollout-*.jsonl
# Deliberate test fixtures remain trackable.
!/tests/fixtures/**/codex-session-*
!/tests/fixtures/**/rollout-*

# Editor, OS, and temporary files.
.idea/
.vscode/
.history/
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
*.orig
