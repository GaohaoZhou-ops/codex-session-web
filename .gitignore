# Dependencies and generated frontend assets.
node_modules/
/public/assets/

# Local service state, caches, and logs.
/.run/
/.cache/
/.npm/
/logs/
/report.*.json
# Default Node diagnostic report names, including reports in subdirectories.
report.[0-9]*.json
*.log
*.log.*
*.pid
*.pid.lock
*.heapsnapshot
*.heapprofile
*.cpuprofile

# Test reports and coverage.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/.playwright-mcp/
/.playwright/
/.local-browsers/
/coverage/
/.nyc_output/

# Local browser debugging output; documentation images remain trackable.
/artifacts/
/screenshots/
/traces/

# Local environment values; keep shareable templates trackable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Session archive data stays local; version only its directory helper.
/sessions/*
!/sessions/today.sh

# Private exports, including copies organized into subdirectories.
codex-session-*.[mM][dD]
codex-session-*.[mM][aA][rR][kK][dD][oO][wW][nN]
codex-session-*.[tT][xX][tT]
codex-session-*.[jJ][sS][oO][nN][lL]
rollout-*.[jJ][sS][oO][nN][lL]
# Deliberate test exports remain trackable without exempting logs or profiles.
!/tests/fixtures/**/codex-session-*.[mM][dD]
!/tests/fixtures/**/codex-session-*.[mM][aA][rR][kK][dD][oO][wW][nN]
!/tests/fixtures/**/codex-session-*.[tT][xX][tT]
!/tests/fixtures/**/codex-session-*.[jJ][sS][oO][nN][lL]
!/tests/fixtures/**/rollout-*.[jJ][sS][oO][nN][lL]

# Editor, OS, and temporary files.
/tmp/
/temp/
/.tmp/
.idea/
.vscode/
.history/
.DS_Store
._*
Thumbs.db
Desktop.ini
*:Zone.Identifier*
*.swp
*.swo
*.swn
*~
*.tmp
*.temp
*.bak
*.orig
*.rej
